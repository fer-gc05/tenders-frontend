# URL base usada por Axios para consumir la API.
# - En desarrollo: puede ser /api/v1 si usas el proxy de Vite (ver vite.config.ts).
# - En producción: usa la URL pública completa del backend si el frontend y el
#   backend están en dominios separados, por ejemplo:
#   VITE_API_BASE_URL=https://tenders-api.duckdns.org/api/v1
# - Si ambos comparten dominio y el servidor web hace proxy de /api/v1, deja /api/v1.
VITE_API_BASE_URL=/api/v1

# Destino del proxy de desarrollo de Vite para /api.
# Solo se usa en desarrollo (npm run dev); en producción no tiene efecto.
VITE_API_PROXY_TARGET=https://tenders-api.duckdns.org
